# Supabase — get these from your Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key — used for privileged admin operations. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth redirects / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
